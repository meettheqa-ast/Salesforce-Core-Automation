# 1) Copy this file to `.env` in the project root (same folder as app.py).
# 2) Default stack uses Google Gemini — set GEMINI_API_KEY from https://aistudio.google.com/apikey
# 3) To switch provider: set LLM_PROVIDER to one of: gemini | openai | groq | mistral | together | openrouter | anthropic | cohere | cursor
# 4) Restart Streamlit after saving `.env`.
# Never commit `.env` (it is gitignored).
#
# AUTO-FAILOVER:
#   When the primary provider hits a quota / rate-limit / auth / network error,
#   ai_bridge.call_llm automatically falls over to the next provider with an
#   API key, recording the switch on a thread-local notes buffer. Override the
#   order with LLM_FAILOVER_ORDER (CSV); disable entirely with LLM_FAILOVER_DISABLED=1.
# LLM_FAILOVER_ORDER=cursor,anthropic,gemini,openai,groq

LLM_PROVIDER=gemini

# ── Google Gemini (default) ── https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── OpenAI / ChatGPT ── https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# ── Groq ── https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Mistral AI ── https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# ── Together AI ── https://api.together.xyz/settings/api-keys
# TOGETHER_API_KEY=
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ── OpenRouter ── https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ── Anthropic (Claude) ── https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Cohere ── https://dashboard.cohere.com/api-keys
# COHERE_API_KEY=
# COHERE_MODEL=command-r-plus

# ── Cursor (Cloud Agents API) ──
# Routes prompts through your existing Cursor subscription. Generate a key at:
#   https://cursor.com/dashboard/integrations
# CURSOR_AGENT_REPO is required by the Cloud Agents API: any GitHub repo URL
# you have access to works (we never push to it; the answer is read from the
# agent's assistant text stream and the agent record is deleted after every
# call). Cold-start adds ~30-60 s vs direct LLM APIs, so we recommend
# placing 'cursor' last in LLM_FAILOVER_ORDER.
# CURSOR_API_KEY=crsr_...
# CURSOR_AGENT_REPO=https://github.com/<your-org>/<any-repo>
# CURSOR_MODEL=claude-4-sonnet-thinking
# CURSOR_AGENT_TIMEOUT_S=180

# ── RF-MCP Server (optional — only needed for MCP Stepwise mode) ──
# Must use a port different from the AI QA Portal API (default 8000). Default RF-MCP port is 8765.
# RFMCP_HOST=127.0.0.1
# RFMCP_PORT=8765
# MCP Stepwise phase timeouts (seconds). Defaults are tuned for long-running
# real browser automation on Salesforce.
# MCP_PLAN_TIMEOUT_S=90
# MCP_INIT_TIMEOUT_S=180
# MCP_STEP_TIMEOUT_S=60
# MCP_BUILD_TIMEOUT_S=60
# Diagnostic mode: surface real MCP failures instead of auto-falling back.
# MCP_STEPWISE_NO_FALLBACK=0
# LLM SDK timeout for OpenAI/Gemini/Anthropic/Cohere calls.
# LLM_REQUEST_TIMEOUT_S=60
# Runtime form-healing budgets.
# HEAL_MAX_ATTEMPTS_PER_SAVE=3
# HEAL_MAX_PER_TEST=6
# HEAL_MAX_LLM_CALLS=1
# HEAL_TIMEOUT_S=60
# Pattern-bank locale for classifier (en/es/fr/de).
# HEAL_PATTERN_LOCALE=en

# ── Persistent paths (Docker / Fly mount these onto a volume) ──
# DATA_DIR=./ai_qa_portal/data
# OUTPUT_DIR=./ai_qa_portal/outputs
# RESULTS_DIR=./Results
# SAVED_PROJECTS_DIR=./Saved_Projects

# ── Backend secrets ──
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FERNET_KEY=

# ── Auth (Phase 1) ──
# OAuth 2.0 Client ID from Google Cloud Console. Required when AUTH_DISABLED=false.
# MUST match the frontend's GOOGLE_CLIENT_ID -- the backend uses this as the
# expected `aud` claim when verifying Google ID tokens via Google's JWKS.
# GOOGLE_CLIENT_ID=
# Lock sign-in to a single Google Workspace domain. Empty string = any Google account.
# ALLOWED_EMAIL_DOMAIN=astounddigital.com
# Comma-separated emails auto-promoted to admin on first login. Always include
# at least one bootstrap admin, otherwise nobody can manage users later.
# INITIAL_ADMINS=m.sheth@astounddigital.com
# Set to true ONLY for local dev / migration with no frontend running.
# When true, every request is treated as a synthetic 'dev@local' admin.
# AUTH_DISABLED=false
#
# Note on session lifetime: the frontend's NextAuth `jwt` callback
# silently refreshes the Google ID token in the background using the
# refresh_token captured during OAuth (access_type=offline,
# prompt=consent in frontend/src/auth.ts). Users no longer get logged
# out after ~1h of idle / laptop lock; sign-out only happens when the
# user clicks Sign out, revokes access from
# https://myaccount.google.com/permissions, or the 30-day NextAuth
# session cookie elapses. No backend env var changes are required;
# the refresh flow lives entirely in the frontend and uses the same
# GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET configured for Vercel.

# ── CORS ──
# *.vercel.app and localhost are auto-allowed via regex in main.py.
# Add custom domains as a comma-separated list:
# EXTRA_CORS_ORIGINS=https://qa.example.com,https://staging.example.com

# ── Salesforce DX MCP (requires Node.js + Salesforce CLI) ──
# First authenticate: sf org login web --alias my-sandbox --instance-url https://yourorg--sbx.sandbox.my.salesforce.com
# SF_DX_ORG_ALIAS=my-sandbox
# SF_DX_TOOLSETS=orgs,metadata,data,testing
