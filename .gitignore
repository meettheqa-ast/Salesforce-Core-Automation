# Local secrets (API keys for ai_bridge.py)
.env
ai_qa_portal/.env
.streamlit/secrets.toml

# AI QA Portal local data + run outputs (per-user)
ai_qa_portal/data/
ai_qa_portal/outputs/

# RF-MCP runtime scratch artefacts (per-session screenshots, html dumps,
# response payloads). Captured by the live MCP runtime when stepwise
# generation runs; useful locally for debugging but never committed.
.robotmcp_artifacts/

# Local docker compose volume mount -- contains runtime SQLite (users.db),
# personas/orgs/user-stories JSON, generated test data. Never commit.
_local_data/

# Temporary commit message scratch file used by the agent for HEREDOC-style
# multi-line commits on Windows (PowerShell doesn't support heredoc).
.commit_msg.tmp

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Cursor IDE workspace state. Only the project-shared bits live here
# now -- `hooks/` and `hooks.json` for shared automation guardrails
# (lint-after-edit, etc.). User-level plans / agent-transcripts live
# in `~/.cursor/` (not the project copy) and are unaffected. Debug
# logs are noisy per-machine and ignored explicitly below.
.cursor/debug-*.log
.cursor/logs/

# Runtime Salesforce credentials (written by run_test.py / app)
Resources/TestData/EnvData.robot

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# LLM-generated tests (optional local only)
Tests/Generated/

# Saved workspace projects (user tests + CSV — do not commit customer data)
Saved_Projects/

# Ignore the entire venv folder
venv/

# Ignore all files inside each folder within Results, but keep the folders
Results/

# Ignore all allure files present within output folder.
output/
allure-report/

# Robot default output when run from project root
/log.html
/output.xml
/report.html

# Playwright MCP visual-regression baselines (per-developer; never commit)
.screenshot-baselines/

# Cursor SDK sidecar: only the package.json + lockfile + server.js + README
# are committed. node_modules/ is generated by `npm install` (or baked into
# the Docker image at build time via `npm ci`).
cursor_sdk_sidecar/node_modules/
