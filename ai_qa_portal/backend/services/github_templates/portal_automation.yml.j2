# GENERATED BY THE AI QA PORTAL. DO NOT EDIT BY HAND.
#
# This workflow is rewritten every time you change a schedule or push
# scripts from the portal. Any manual edits will be lost on the next
# sync. To change behaviour, update the template in
# ai_qa_portal/backend/services/github_templates/portal_automation.yml.j2
# inside the portal repo.
name: Portal Automation

on:
  workflow_dispatch:
    inputs:
      suite_path:
        description: "Path to the .robot suite (relative to repo root)"
        required: true
        type: string
      persona_username:
        description: "Salesforce username for this run"
        required: true
        type: string
      schedule_run_id:
        description: "Portal schedule_run id (for webhook correlation)"
        required: false
        type: string
        default: ""
{%- if schedules %}
  schedule:
{%- for s in schedules %}
    # {{ s.name }} (portal schedule_id={{ s.id }})
    - cron: "{{ s.cron }}"
{%- endfor %}
{%- endif %}

permissions:
  contents: read
  actions: read

jobs:
  run-robot:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: "pip"

      - name: Install Robot + browsers
        run: |
          python -m pip install --upgrade pip
          pip install robotframework robotframework-seleniumlibrary webdriver-manager

      - name: Install Chrome
        uses: browser-actions/setup-chrome@v1
        with:
          chrome-version: stable

      - name: Resolve persona credentials from repo secrets
        id: creds
        env:
          PERSONA_USERNAME: ${% raw %}{{ inputs.persona_username }}{% endraw %}
        run: |
          # Repo secrets are uppercased and dotted into PERSONA_<USER>_PASSWORD.
          # The portal sets these secrets via the GitHub App when a persona is connected.
          slug="$(echo "$PERSONA_USERNAME" | tr '[:lower:]' '[:upper:]' | tr -c 'A-Z0-9' '_')"
          var_name="PERSONA_${slug}_PASSWORD"
          password="$(printenv "$var_name" || true)"
          if [ -z "$password" ]; then
            echo "::error::Missing repo secret $var_name. Open the portal and click 'Sync credentials' on this persona."
            exit 1
          fi
          echo "password=$password" >> "$GITHUB_OUTPUT"

      - name: Run suite
        env:
          PERSONA_USERNAME: ${% raw %}{{ inputs.persona_username }}{% endraw %}
          PERSONA_PASSWORD: ${% raw %}{{ steps.creds.outputs.password }}{% endraw %}
          SANDBOX_URL: ${% raw %}{{ secrets.SANDBOX_URL }}{% endraw %}
        run: |
          mkdir -p Results
          robot \
            --variable globalSandboxTestUrl:"$SANDBOX_URL" \
            --variable sandboxUserNameInput:"$PERSONA_USERNAME" \
            --variable sandboxPasswordInput:"$PERSONA_PASSWORD" \
            --outputdir Results \
            "${% raw %}{{ inputs.suite_path }}{% endraw %}"

      - name: Upload artefacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: robot-results
          path: Results
          retention-days: 14

      - name: Notify portal
        if: always() && env.PORTAL_WEBHOOK_URL != ''
        env:
          PORTAL_WEBHOOK_URL: ${% raw %}{{ secrets.PORTAL_WEBHOOK_URL }}{% endraw %}
          SCHEDULE_RUN_ID: ${% raw %}{{ inputs.schedule_run_id }}{% endraw %}
          STATUS: ${% raw %}{{ job.status }}{% endraw %}
        run: |
          # Portal verifies the GitHub webhook signature; the portal webhook
          # secret is configured separately as `PORTAL_WEBHOOK_SECRET`.
          curl -fsSL -X POST "$PORTAL_WEBHOOK_URL" \
            -H "Content-Type: application/json" \
            -d "{\"schedule_run_id\":\"$SCHEDULE_RUN_ID\",\"status\":\"$STATUS\",\"run_url\":\"$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID\"}" \
          || true
