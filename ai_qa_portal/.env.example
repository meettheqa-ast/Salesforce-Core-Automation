# Backend (FastAPI) configuration. Copy to ai_qa_portal/.env locally; on Fly use
# `flyctl secrets set KEY=VALUE` so secrets never land in the image or git.

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: keep this stable across restarts or stored persona passwords become unreadable.
FERNET_KEY=

# Public URL where the backend is reachable (used for self-references in messages).
API_BASE_URL=http://localhost:8000

# CORS — base list of explicit origins.
# Note: ai_qa_portal/backend/main.py also auto-allows *.vercel.app and localhost
# via regex, so you only need to add custom domains here.
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
EXTRA_CORS_ORIGINS=

# Persistent paths. In Docker / Fly these point at the mounted volume (/data).
DATA_DIR=./data
OUTPUT_DIR=./outputs
RESULTS_DIR=./Results
SAVED_PROJECTS_DIR=./Saved_Projects

# RF-MCP (stepwise generation). Must NOT collide with the API port (default 8000).
RFMCP_HOST=127.0.0.1
RFMCP_PORT=8765

# LLM provider selection. Cursor SDK is the default primary when
# CURSOR_API_KEY is set. The Python backend spawns the @cursor/sdk Node
# sidecar (cursor_sdk_sidecar/) on first request; on hosts without Node
# (or with CURSOR_USE_SDK=false) it transparently falls back to the
# legacy Cursor Cloud Agents REST API. Set LLM_PROVIDER=<other> to force
# a different primary regardless.
LLM_PROVIDER=cursor

# Cursor (SDK + REST). Mint a key at https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
# Optional: explicit model id (composer-2, claude-4-sonnet-thinking, etc.).
# Defaults to composer-2. Run Cursor.models.list({apiKey}) in the SDK to enumerate.
CURSOR_MODEL=composer-2
# Optional: 'true' (default) uses the @cursor/sdk Node sidecar.
# 'false' forces the legacy REST path (which requires CURSOR_AGENT_REPO).
CURSOR_USE_SDK=true
# Optional sidecar config (defaults shown):
CURSOR_SDK_PORT=8767
CURSOR_SDK_TIMEOUT_S=180
# Legacy REST-only path (only needed when CURSOR_USE_SDK=false):
CURSOR_AGENT_REPO=

# Optional explicit failover order. When unset, the chain is:
#   primary (cursor by default) -> remaining providers with API keys,
#   in the order they appear in LLM_PROVIDERS.
LLM_FAILOVER_ORDER=cursor,gemini,openai,anthropic,groq

# Existing fallback providers (failover chain runs through these in
# order when Cursor is exhausted/down):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GROQ_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=

# --- Database (Postgres + pgvector) ---
# Production: a Postgres URL with the psycopg driver. When left empty, the
# backend falls back to legacy SQLite at {DATA_DIR}/users.db (dev only).
# Example:
#   DATABASE_URL=postgresql+psycopg://portal:portal@localhost:5432/portal
DATABASE_URL=
# Whether to run `CREATE EXTENSION IF NOT EXISTS vector` on startup. Set to
# false if the DB user lacks SUPERUSER and the extension is installed
# manually by your DBA.
PGVECTOR_AUTO_INSTALL=true

# --- Embeddings ---
# Pluggable: openai | ollama | gemini. OpenAI text-embedding-3-small is
# 1536-dim and matches the VECTOR(1536) column shipped in the schema; if
# you switch models, you must also adjust EMBEDDING_DIM and re-run the
# alembic migration that recreates the embeddings table.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_EMBEDDINGS_API_KEY=

# --- Jira (org-wide default; per-project overrides via UI) ---
# Generate an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- GitHub App (preferred) ---
# Create a GitHub App at https://github.com/settings/apps/new and grant it
# Contents: read/write, Actions: read/write, Metadata: read, Workflows:
# read/write. Webhook URL: <API_BASE_URL>/webhooks/github. Permissions:
# subscribe to workflow_run, check_run, installation events.
GITHUB_APP_ID=
# PEM contents (multi-line). In .env you can keep it on one line with \n
# escapes; the backend normalises both.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Public install URL surfaced in the Settings UI:
GITHUB_APP_INSTALL_URL=

# --- Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_MAX_WORKERS=4
