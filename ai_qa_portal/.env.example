# Backend (FastAPI) configuration. Copy to ai_qa_portal/.env locally; on Fly use
# `flyctl secrets set KEY=VALUE` so secrets never land in the image or git.

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: keep this stable across restarts or stored persona passwords become unreadable.
FERNET_KEY=

# Public URL where the backend is reachable (used for self-references in messages).
API_BASE_URL=http://localhost:8000

# CORS — base list of explicit origins.
# Note: ai_qa_portal/backend/main.py also auto-allows *.vercel.app and localhost
# via regex, so you only need to add custom domains here.
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
EXTRA_CORS_ORIGINS=

# Persistent paths. In Docker / Fly these point at the mounted volume (/data).
DATA_DIR=./data
OUTPUT_DIR=./outputs
RESULTS_DIR=./Results
SAVED_PROJECTS_DIR=./Saved_Projects

# RF-MCP (stepwise generation). Must NOT collide with the API port (default 8000).
RFMCP_HOST=127.0.0.1
RFMCP_PORT=8765

# LLM provider selection + keys (only set the ones you use).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GROQ_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
